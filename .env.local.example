# Kill switches: OA_KILL_SWITCH=1 (all), OA_KILL_UL / OA_KILL_BLM / OA_KILL_GLO / OA_KILL_RRC =1
# RRC staged files directory (<kind>.dat: permit, production_oil, production_gas)
