# AMARA Constitution version, format vYYYY.MM.DD.N. Defaults to v2026.10.30.1 (confirmed by Scott 2026-11-07); set only if the Constitution changes
OA_CONSTITUTION_VERSION=
# Permit master months you accept as unavailable (YYYY-MM, comma separated). OFF by default; every candidate then carries PERMIT_MONTH_UNAVAILABLE:<month>
OA_ALLOW_MISSING_PERMIT_MONTHS=
