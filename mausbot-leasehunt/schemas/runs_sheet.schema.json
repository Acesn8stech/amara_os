{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mausbot-leasehunt/schemas/runs_sheet.schema.json",
  "title": "Mineral title Runs Sheet",
  "type": "object",
  "required": ["tract_id", "state", "county", "gross_acres", "subject_owner", "entries"],
  "properties": {
    "tract_id": {"type": "string"},
    "state": {"type": "string", "minLength": 2, "maxLength": 2},
    "county": {"type": "string"},
    "gross_acres": {"type": "number", "exclusiveMinimum": 0},
    "subject_owner": {"type": "string", "minLength": 1},
    "imaging_start_year": {"type": ["integer", "null"]},
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["seq", "instrument_id", "entry_type", "instrument_date", "evidence"],
        "properties": {
          "seq": {"type": "integer", "minimum": 1},
          "instrument_id": {"type": "string", "minLength": 1},
          "entry_type": {"enum": ["SOVEREIGN_PATENT", "WARRANTY_DEED", "MINERAL_DEED", "ROYALTY_DEED", "RESERVATION",
                                  "OIL_GAS_LEASE", "LEASE_RELEASE", "AFFIDAVIT_NON_PRODUCTION", "MORTGAGE", "MORTGAGE_RELEASE",
                                  "DEATH", "PROBATE_ORDER", "AFFIDAVIT_HEIRSHIP", "OTHER"]},
          "instrument_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "grantor": {"type": ["string", "null"]},
          "grantee": {"type": ["string", "null"]},
          "recording": {
            "type": ["object", "null"],
            "properties": {"county": {"type": "string"}, "book": {"type": "string"}, "page": {"type": "string"}, "instrument_no": {"type": "string"}}
          },
          "interest": {
            "type": ["object", "null"],
            "required": ["type", "fraction", "basis"],
            "properties": {
              "type": {"enum": ["MINERAL", "NPRI"]},
              "fraction": {"type": "string", "pattern": "^\\d+(/\\d+)?$"},
              "basis": {"enum": ["OF_TOTAL", "OF_GRANTOR_INTEREST"]}
            }
          },
          "imaged_online": {"type": "boolean"},
          "homestead": {"type": "boolean"},
          "spouse_joined": {"type": ["boolean", "null"]},
          "primary_term_months": {"type": ["integer", "null"], "description": "OIL_GAS_LEASE entries only"},
          "releases": {"type": ["string", "null"], "description": "instrument_id this entry releases"},
          "notes": {"type": ["string", "null"]},
          "evidence": {
            "type": ["object", "null"],
            "properties": {
              "source_url": {"type": "string"}, "book_page": {"type": "string"}, "docket_no": {"type": "string"},
              "grade": {"enum": ["A", "B", "C", "D"]}
            }
          }
        }
      }
    },
    "nma_math": {
      "type": "object",
      "properties": {
        "gross_acres": {"type": "number"},
        "holders": {"type": "object"},
        "subject_mineral_fraction": {"type": "string"},
        "nma": {"type": "number"},
        "npri_royalty_fraction": {"type": "string"},
        "note": {"type": "string"}
      }
    }
  }
}
